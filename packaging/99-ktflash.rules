# ktflash — udev rules for KTMicro KT02H20 / FiiO JA11 dongles and their bootloader.
#
# Without these, claiming the USB interface on Linux needs root. Installing them grants
# non-root access two ways at once — both are active by default, see why below.
#
# Install:
#   sudo cp packaging/99-ktflash.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
# Then replug the dongle (or re-trigger is enough if it's already attached).
#
# `uaccess` (systemd-logind seat-local access) is the modern desktop mechanism, but it is a
# no-op with no logind seat — confirmed on a headless Debian 13 VM (SSH-only session,
# `loginctl show-session ... -p Seat` prints empty): ktflash probe still needed sudo to read
# manufacturer/product/serial strings with uaccess alone. GROUP="plugdev" is what actually
# grants access there, and it's harmless to leave active on a desktop too (uaccess still wins
# when a seat exists) — so both lines ship uncommented. You need to be in the `plugdev` group
# for the GROUP line to help (most desktop distros add the first user to it automatically;
# on a bare VM: `sudo usermod -aG plugdev $USER`, then log back in).

# Stock KTMicro KT02H20 (and other 0x31b2 dongles) — normal mode
SUBSYSTEM=="usb", ATTR{idVendor}=="31b2", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="31b2", GROUP="plugdev", MODE="0660"

# FiiO / JadeAudio JA11 — already-flashed, normal mode
SUBSYSTEM=="usb", ATTR{idVendor}=="2972", ATTR{idProduct}=="0102", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="2972", ATTR{idProduct}=="0102", GROUP="plugdev", MODE="0660"

# KT_USB_BOOT CDC bootloader (appears after `ktflash unlock`)
SUBSYSTEM=="usb", ATTR{idVendor}=="8888", ATTR{idProduct}=="cdc0", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="8888", ATTR{idProduct}=="cdc0", GROUP="plugdev", MODE="0660"

# The bootloader also exposes a CDC-ACM tty (/dev/ttyACM*) — the serial transport (macOS/Linux)
# drives this; the libusb transport drives the bulk endpoints directly. Both need access:
SUBSYSTEM=="tty", ATTRS{idVendor}=="8888", ATTRS{idProduct}=="cdc0", TAG+="uaccess"
SUBSYSTEM=="tty", ATTRS{idVendor}=="8888", ATTRS{idProduct}=="cdc0", GROUP="plugdev", MODE="0660"
