# ktflash — udev rules for KTMicro KT02H20 / FiiO JA11 dongles and their bootloader.
#
# Without these, claiming the USB interface on Linux needs root. Installing them grants the
# logged-in user access (via systemd-logind `uaccess`), so `ktflash unlock` / `bootdiag` /
# `flash` work without sudo — the roadmap M3 "Linux-native" path, no OrbStack layer.
#
# Install:
#   sudo cp packaging/99-ktflash.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
# Then replug the dongle. (The .deb/.rpm install this to /usr/lib/udev/rules.d for you.)
#
# `uaccess` is the modern approach (seat-local access). If your distro/setup doesn't honor it —
# notably on HEADLESS machines, which have no logind seat — uncomment the GROUP/MODE lines and
# add yourself to the `plugdev` group instead.
#
# NOTE ON VID 0x8888: that is a squatted/placeholder vendor ID, not one KTMicro owns. Every
# 0x8888 rule below therefore keeps its `cdc0` product-ID qualifier — do not relax them to a
# vendor-only match, or an unrelated device could pick up these rules.

# Stock KTMicro KT02H20 (and other 0x31b2 dongles) — normal mode
SUBSYSTEM=="usb", ATTR{idVendor}=="31b2", TAG+="uaccess"
#SUBSYSTEM=="usb", ATTR{idVendor}=="31b2", GROUP="plugdev", MODE="0660"

# FiiO / JadeAudio JA11 — already-flashed, normal mode
SUBSYSTEM=="usb", ATTR{idVendor}=="2972", ATTR{idProduct}=="0102", TAG+="uaccess"
#SUBSYSTEM=="usb", ATTR{idVendor}=="2972", ATTR{idProduct}=="0102", GROUP="plugdev", MODE="0660"

# KT_USB_BOOT CDC bootloader (appears after `ktflash unlock`)
SUBSYSTEM=="usb", ATTR{idVendor}=="8888", ATTR{idProduct}=="cdc0", TAG+="uaccess"
#SUBSYSTEM=="usb", ATTR{idVendor}=="8888", ATTR{idProduct}=="cdc0", GROUP="plugdev", MODE="0660"

# The bootloader also exposes a CDC-ACM tty (/dev/ttyACM*). `ktflash --transport serial` drives
# that tty directly, and the libusb path doesn't need it — either way, uaccess covers it:
SUBSYSTEM=="tty", ATTRS{idVendor}=="8888", ATTRS{idProduct}=="cdc0", TAG+="uaccess"
#SUBSYSTEM=="tty", ATTRS{idVendor}=="8888", ATTRS{idProduct}=="cdc0", GROUP="plugdev", MODE="0660"

# --- Keep ModemManager off the bootloader -------------------------------------------------
# NEW (docs/RELEASE-PLAN.md §5.3). After `unlock` the device exposes a CDC-ACM tty, and on both
# Debian and Alma, ModemManager opens new ttyACM* devices to probe for AT-capable modems. That
# is a live race against ktflash for the same interface during a flash, and a plausible cause of
# intermittent failures. ktflash already calls set_auto_detach_kernel_driver() so cdc_acm itself
# is handled — ModemManager is a separate actor that nothing currently keeps out.
#
# UNVERIFIED: not yet confirmed that ModemManager actually probes THIS device. Test both ways
# per docs/LINUX-TESTING.md P2 before deciding whether this ships as a fix or a comment.
SUBSYSTEM=="usb", ATTR{idVendor}=="8888", ATTR{idProduct}=="cdc0", ENV{ID_MM_DEVICE_IGNORE}="1"
SUBSYSTEM=="tty", ATTRS{idVendor}=="8888", ATTRS{idProduct}=="cdc0", ENV{ID_MM_DEVICE_IGNORE}="1"
